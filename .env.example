# MandatePay configuration. Copy to `.env` and edit only what you need.
#
# The defaults run the whole demo offline:
#   * no PayPal credentials -> deterministic mock PayPal
#   * no LLM credentials    -> deterministic rules planner and verifier
#   * no network required
#
# Everything below is optional. Values in `.env` never override variables that
# are already set in the real environment.

# --- App --------------------------------------------------------------------
APP_NAME=MandatePay
DATA_DIR=./data
SAMPLES_DIR=./samples
DEMO_MODE=true
MAX_UPLOAD_MB=8
APPROVAL_TTL_MINUTES=30
APPROVAL_TOKEN_TTL_MINUTES=20

# --- PayPal (sandbox) -------------------------------------------------------
# Create an app at https://developer.paypal.com/dashboard/applications/sandbox
# Leave these blank to use the mock adapter.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_PAYOUTS_ENABLED=true

# Force the deterministic mock even if credentials are present.
PAYPAL_FORCE_MOCK=false

# Live money is intentionally gated. Keep this false for the hackathon.
ALLOW_LIVE=false

# Where the freelancer is paid in the sandbox. The default is a fake address;
# use a sandbox account that can receive Payouts when testing for real.
FREELANCER_NAME=Avery Quinn
FREELANCER_EMAIL=freelancer@example.com
PLATFORM_FEE_BPS=0

# --- AI planner / verifier (optional) --------------------------------------
# auto | openai | anthropic | ollama | none
# With "auto", a key + model selects OpenAI, otherwise the rules engine is used.
LLM_PROVIDER=auto
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=40
LLM_MIN_CONFIDENCE=0.7
